{
  "name": "soldout-for-muse",
  "version": "0.2.1",
  "private": true,
  "description": "SOLD OUT (MUTOYS, GPL) を TypeScript に移植し、AI が HTTP API で遊べるようにしたもの",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/main.js",
    "test": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning --test \"dist/test/**/*.test.js\"",
    "items": "perl tools/dump-items.pl normal > src/data/items.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
